{
  "name": "cleandrive",
  "version": "0.1.5",
  "description": "Disk space analyser, duplicate finder and scheduled cleaner",
  "repository": {
    "type": "git",
    "url": "https://github.com/TonDungx/cleandrive.git"
  },
  "homepage": "https://github.com/TonDungx/cleandrive",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test-duplicate.js --fixture && node scripts/test-advisor.js && node scripts/test-protection.js && node scripts/test-appsafety.js && node scripts/test-trash.js && node scripts/test-trash-progress.js && node scripts/test-settings.js && node scripts/test-recyclebin.js && node scripts/test-autoclean.js && node scripts/test-scheduler.js && node scripts/test-history.js && node scripts/test-monitor.js && node scripts/test-i18n.js",
    "test:scanner": "node scripts/test-scanner.js",
    "test:duplicate": "node scripts/test-duplicate.js --fixture",
    "test:advisor": "node scripts/test-advisor.js",
    "test:trash": "node scripts/test-trash.js",
    "test:progress": "node scripts/test-trash-progress.js",
    "bench:trash": "electron scripts/bench-trash.js",
    "test:e2e": "electron scripts/smoke.js",
    "verify:trash": "electron scripts/verify-trash.js",
    "verify:autoclean": "electron scripts/verify-autoclean.js",
    "verify:monitor": "electron scripts/verify-monitor.js",
    "test:protection": "node scripts/test-protection.js",
    "test:permission": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-permission.ps1",
    "bench:batch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bench-batch.ps1",
    "test:appsafety": "node scripts/test-appsafety.js",
    "test:settings": "node scripts/test-settings.js",
    "test:recyclebin": "node scripts/test-recyclebin.js",
    "test:autoclean": "node scripts/test-autoclean.js",
    "test:scheduler": "node scripts/test-scheduler.js",
    "test:history": "node scripts/test-history.js",
    "test:monitor": "node scripts/test-monitor.js",
    "test:i18n": "node scripts/test-i18n.js",
    "test:scheduler:live": "node scripts/test-scheduler.js --live",
    "scheduled-run": "electron . --scheduled-run",
    "sample-only": "electron . --sample-only",
    "verify:schedule": "electron scripts/verify-schedule.js",
    "verify:appearance": "electron scripts/verify-appearance.js",
    "build": "node scripts/build.js",
    "verify:install": "node scripts/verify-install-location.js",
    "verify:updater": "electron scripts/verify-updater.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
